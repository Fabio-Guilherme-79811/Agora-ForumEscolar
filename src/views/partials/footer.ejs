<%
/*
 * partials/footer.ejs — Rodapé em camadas da Ágora. Serve às páginas
 * públicas e às logadas.
 * Parâmetros (opcionais):
 *   usuario (objeto)  com usuário, a coluna "Acesso" vira "Fórum" (links do app).
 *   vidro   (boolean) true mostra o "Ágora" gigante com efeito de vidro no fim
 *                     (usa o filtro SVG #efeito-vidro e o rodape-landing.js).
 * As redes usam href="#" como placeholder: troque pelos perfis reais da equipe.
 * Estilos: /css/components/cabeca-rodape.css
 * Regra de segurança: apenas a tag de saída escapada do EJS.
 */
const IMG = '/css/uploads/materials/';
const usuario = locals.usuario || null;
const vidro = Boolean(locals.vidro);
%>
<footer class="rodape-camadas<%= vidro ? ' rodape-camadas--vidro' : '' %>">
  <% if (vidro) { %>
    <svg class="rodape-camadas__defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="efeito-vidro" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.25" result="outer-shadow"/>
          <feComponentTransfer in="SourceAlpha" result="alpha"><feFuncA type="linear" slope="1"/></feComponentTransfer>
          <feOffset in="alpha" dx="0" dy="4" result="offset-white"/>
          <feGaussianBlur in="offset-white" stdDeviation="4" result="blur-white"/>
          <feComposite in="alpha" in2="blur-white" operator="out" result="inner-white-mask"/>
          <feFlood flood-color="#ffffff" flood-opacity="0.25" result="white-fill"/>
          <feComposite in="white-fill" in2="inner-white-mask" operator="in" result="inner-white-final"/>
          <feGaussianBlur in="alpha" stdDeviation="6" result="blur-black"/>
          <feComposite in="alpha" in2="blur-black" operator="out" result="inner-black-mask"/>
          <feFlood flood-color="#000000" flood-opacity="0.25" result="black-fill"/>
          <feComposite in="black-fill" in2="inner-black-mask" operator="in" result="inner-black-final"/>
          <feMerge>
            <feMergeNode in="outer-shadow"/>
            <feMergeNode in="SourceGraphic"/>
            <feMergeNode in="inner-white-final"/>
            <feMergeNode in="inner-black-final"/>
          </feMerge>
        </filter>
      </defs>
    </svg>
  <% } %>

  <div class="rodape-camadas__corpo">
    <div class="rodape-camadas__caixa">
      <div class="rodape-camadas__marca-bloco">
        <a class="rodape-camadas__marca" href="/" aria-label="Ágora, página inicial">
          <span class="rodape-camadas__logo"><img src="<%= IMG %>logo.png" width="24" height="24" alt=""></span>
          <span>Ágo<span class="rodape-camadas__ra">ra</span></span>
        </a>
        <p class="rodape-camadas__descricao">Fórum escolar de perguntas e respostas, com a resposta certa validada pelo professor.</p>
        <ul class="rodape-camadas__redes">
          <li>
            <a class="rodape-camadas__rede" href="#" aria-label="Instagram da Ágora" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5"/></svg>
            </a>
          </li>
          <li>
            <a class="rodape-camadas__rede" href="#" aria-label="GitHub do projeto" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
          </li>
          <li>
            <a class="rodape-camadas__rede" href="#" aria-label="LinkedIn da equipe" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </li>
          <li>
            <a class="rodape-camadas__rede" href="#" aria-label="E-mail da equipe" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="rodape-camadas__coluna" aria-labelledby="rodape-explorar">
        <h2 class="rodape-camadas__titulo" id="rodape-explorar">Explorar</h2>
        <ul>
          <li><a href="/#como-funciona">Como funciona</a></li>
          <li><a href="/#recursos">Recursos</a></li>
          <li><a href="/#na-pratica">Na prática</a></li>
        </ul>
      </nav>

      <nav class="rodape-camadas__coluna" aria-labelledby="rodape-acesso">
        <% if (usuario) { %>
          <h2 class="rodape-camadas__titulo" id="rodape-acesso">Fórum</h2>
          <ul>
            <li><a href="/perguntas">Perguntas</a></li>
            <li><a href="/disciplinas">Disciplinas</a></li>
            <li><a href="/termometro">Termômetro</a></li>
          </ul>
        <% } else { %>
          <h2 class="rodape-camadas__titulo" id="rodape-acesso">Acesso</h2>
          <ul>
            <li><a href="/login">Entrar</a></li>
            <li><a href="/cadastro">Criar conta</a></li>
          </ul>
        <% } %>
      </nav>

      <div class="rodape-camadas__coluna">
        <h2 class="rodape-camadas__titulo" id="rodape-projeto">Projeto</h2>
        <ul aria-labelledby="rodape-projeto">
          <li>Senac-RN</li>
          <li>MedioTec</li>
          <li>Projeto Integrador</li>
        </ul>
      </div>
    </div>

    <div class="rodape-camadas__legal">
      <p>© 2026 Ágora · Senac RN · MedioTec</p>
      <div class="rodape-camadas__legal-direita">
        <p>Coletamos o mínimo de dados pessoais, conforme a LGPD.</p>
        <span class="rodape-camadas__separador" aria-hidden="true"></span>
        <a href="#">Voltar ao topo</a>
      </div>
    </div>
  </div>

  <% if (vidro) { %>
    <div class="rodape-camadas__vidro" data-vidro aria-hidden="true">
      <p class="rodape-camadas__vidro-texto">Ágora</p>
    </div>
  <% } %>
</footer>
<% if (vidro) { %><script src="/js/rodape-landing.js" defer></script><% } %>