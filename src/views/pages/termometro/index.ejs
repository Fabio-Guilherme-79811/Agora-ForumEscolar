<%
/*
 * termometro/index.ejs — Termômetro de dúvidas por disciplina (UC-10).
 * Rota: GET /termometro (exige login — RN-01).
 * Variáveis enviadas pela rota:
 *   usuario     (objeto)  nome e perfil
 *   itens       (array)   já ordenados do mais quente ao mais frio, com id, nome,
 *                         temperatura, faixa ('frio', 'morno' ou 'quente') e faixaRotulo
 *   ehProfessor (boolean) só o Professor recebe, em cada item, perguntas e tambemTenho (RN-29)
 * A temperatura é o total de perguntas mais "também tenho" dos últimos 7 dias (RN-26).
 * Faixas: Frio 0 a 4, Morno 5 a 14, Quente 15 ou mais (RN-27).
 * A faixa é indicada por ícone e texto, nunca só por cor.
 * Estilos: /css/pages/termometro.css, /css/components/navbar.css e perguntas.css
 * Regra de segurança: apenas a tag de saída escapada do EJS. A tag sem
 * escape aparece só nos includes, que inserem templates do projeto.
 */
const titulo = locals.titulo || 'Termômetro de dúvidas — Ágora';
const usuario = locals.usuario || null;
const itens = locals.itens || [];
const ehProfessor = Boolean(locals.ehProfessor);
const faixas = [
  { chave: 'quente', rotulo: 'Quente', icone: '▲', regra: '15 ou mais', ajuda: 'Muita dúvida acumulada. Vale priorizar.' },
  { chave: 'morno', rotulo: 'Morno', icone: '●', regra: '5 a 14', ajuda: 'Atividade moderada de dúvidas.' },
  { chave: 'frio', rotulo: 'Frio', icone: '○', regra: '0 a 4', ajuda: 'Poucas dúvidas nos últimos dias.' }
];
function plural(n, singular, pluralTexto) {
  return n + ' ' + (n === 1 ? singular : pluralTexto);
}
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Veja quais disciplinas da turma concentram mais dúvidas nos últimos 7 dias.">
  <title><%= titulo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components/navbar.css">
  <link rel="stylesheet" href="/css/pages/perguntas.css">
  <link rel="stylesheet" href="/css/pages/termometro.css">
</head>
<body class="feed termo">
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <%- include('../../partials/header', { usuario: usuario, ativo: 'termometro' }) %>

  <main id="conteudo" class="feed__main">
    <%- include('../../partials/nav', { trilha: [{ rotulo: 'Termômetro' }] }) %>

    <div class="feed__cabeca">
      <div>
        <h1>Termômetro de dúvidas</h1>
        <p class="feed__sub">Quanto mais perguntas e marcações de &ldquo;também tenho&rdquo; nos últimos 7 dias, mais quente a disciplina.</p>
      </div>
    </div>

    <% if (itens.length > 0) { %>
      <% faixas.forEach(function (f) { %>
        <% const grupo = itens.filter(function (i) { return i.faixa === f.chave; }); %>
        <section class="termo__faixa termo__faixa--<%= f.chave %>" aria-labelledby="faixa-<%= f.chave %>">
          <h2 class="termo__titulo" id="faixa-<%= f.chave %>">
            <span aria-hidden="true"><%= f.icone %></span> <%= f.rotulo %>
            <span class="termo__regra">(<%= f.regra %>)</span>
            <span class="termo__total"><%= plural(grupo.length, 'disciplina', 'disciplinas') %></span>
          </h2>

          <% if (grupo.length > 0) { %>
            <ul class="termo__lista">
              <% grupo.forEach(function (d) { %>
                <% const temperatura = Number(d.temperatura) || 0; %>
                <li class="termo__item termo__item--<%= f.chave %>">
                  <div class="termo__nome">
                    <a href="/disciplinas/<%= d.id %>"><%= d.nome %></a>
                    <span class="termo__selo termo__selo--<%= f.chave %>"><span aria-hidden="true"><%= f.icone %></span> <%= d.faixaRotulo %></span>
                  </div>
                  <p class="termo__valor"><%= plural(temperatura, 'ponto', 'pontos') %></p>
                  <% if (ehProfessor) { %>
                    <dl class="termo__detalhes">
                      <div>
                        <dt>Perguntas</dt>
                        <dd><%= Number(d.perguntas) || 0 %></dd>
                      </div>
                      <div>
                        <dt>Também tenho</dt>
                        <dd><%= Number(d.tambemTenho) || 0 %></dd>
                      </div>
                    </dl>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p class="termo__vazio">Nenhuma disciplina nesta faixa. <%= f.ajuda %></p>
          <% } %>
        </section>
      <% }); %>
    <% } else { %>
      <div class="vazio">
        <h2>Nenhuma disciplina para exibir</h2>
        <p>As disciplinas da turma aparecem aqui assim que forem cadastradas.</p>
        <a class="btn" href="/perguntas">Ver perguntas</a>
      </div>
    <% } %>

    <p class="termo__nota">
      Pontos = perguntas + &ldquo;também tenho&rdquo; dos últimos 7 dias.
      <% if (!ehProfessor) { %>Os números mostrados são o total da turma, sem identificar ninguém.<% } %>
    </p>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>