<%
/*
 * disciplinas/topico.ejs — Perguntas de um tópico.
 * Rota: GET /disciplinas/:id/topicos/:topicoId (exige login — RN-01). A rota
 * deve responder 404 se a disciplina ou o tópico não existirem.
 * Variáveis enviadas pela rota:
 *   usuario    (objeto) nome e perfil
 *   disciplina (objeto) id e nome
 *   topico     (objeto) id e nome
 *   perguntas  (array)  só da turma do usuário (RN-02), na ordem da RN-10
 * Cada cartão é renderizado por components/pergunta-card (RN-12).
 * Estilos: /css/pages/disciplinas.css, /css/components/navbar.css e cards.css
 * Regra de segurança: apenas a tag de saída escapada do EJS. A tag sem
 * escape aparece só nos includes, que inserem templates do projeto.
 */
const usuario = locals.usuario || null;
const perguntas = locals.perguntas || [];
const titulo = locals.titulo || topico.nome + ' — ' + disciplina.nome + ' — Ágora';
const linkNova = '/perguntas/nova?materia=' + encodeURIComponent(disciplina.id) +
  '&topico=' + encodeURIComponent(topico.id);
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Perguntas da turma sobre este tópico na Ágora.">
  <title><%= titulo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components/navbar.css">
  <link rel="stylesheet" href="/css/components/cards.css">
  <link rel="stylesheet" href="/css/pages/disciplinas.css">
</head>
<body class="disciplinas">
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <%- include('../../partials/header', { usuario: usuario, ativo: 'disciplinas' }) %>

  <main id="conteudo" class="pagina__main">
    <%- include('../../partials/nav', {
      trilha: [
        { rotulo: 'Disciplinas', href: '/disciplinas' },
        { rotulo: disciplina.nome, href: '/disciplinas/' + disciplina.id },
        { rotulo: topico.nome }
      ]
    }) %>

    <div class="pagina__cabeca">
      <div>
        <h1><%= topico.nome %></h1>
        <p class="pagina__sub"><%= disciplina.nome %> · <%= perguntas.length %> <%= perguntas.length === 1 ? 'pergunta' : 'perguntas' %></p>
      </div>
      <a class="btn" href="<%= linkNova %>">Perguntar neste tópico</a>
    </div>

    <% if (perguntas.length > 0) { %>
      <ul class="lista">
        <% perguntas.forEach(function (p) { %>
          <li><%- include('../../components/pergunta-card', { pergunta: p }) %></li>
        <% }); %>
      </ul>
    <% } else { %>
      <div class="vazio">
        <h2>Ainda não há perguntas neste tópico</h2>
        <p>Seja a primeira pessoa a perguntar. Escolha o tópico e escreva sua dúvida.</p>
        <a class="btn" href="<%= linkNova %>">Fazer uma pergunta</a>
      </div>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>