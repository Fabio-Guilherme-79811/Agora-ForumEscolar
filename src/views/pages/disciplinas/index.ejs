<%
/*
 * disciplinas/index.ejs — Lista de disciplinas da turma.
 * Rota: GET /disciplinas (exige login — RN-01).
 * Variáveis enviadas pela rota:
 *   usuario     (objeto) nome e perfil
 *   disciplinas (array)  itens com id, nome, totalTopicos e totalAbertas
 * Estilos: /css/pages/disciplinas.css, /css/components/navbar.css e cards.css
 * Regra de segurança: apenas a tag de saída escapada do EJS. A tag sem
 * escape aparece só nos includes, que inserem templates do projeto.
 */
const titulo = locals.titulo || 'Disciplinas — Ágora';
const usuario = locals.usuario || null;
const disciplinas = locals.disciplinas || [];
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="Disciplinas da sua turma na Ágora, com as dúvidas abertas de cada uma.">
  <title><%= titulo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components/navbar.css">
  <link rel="stylesheet" href="/css/components/cards.css">
  <link rel="stylesheet" href="/css/pages/disciplinas.css">
</head>
<body class="disciplinas">
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <%- include('../../partials/header', { usuario: usuario, ativo: 'disciplinas' }) %>

  <main id="conteudo" class="pagina__main">
    <div class="pagina__cabeca">
      <div>
        <h1>Disciplinas</h1>
        <p class="pagina__sub">Escolha uma disciplina para ver os tópicos e as dúvidas da turma.</p>
      </div>
    </div>

    <% if (disciplinas.length > 0) { %>
      <ul class="grade">
        <% disciplinas.forEach(function (d) { %>
          <li><%- include('../../components/disciplina-card', { disciplina: d }) %></li>
        <% }); %>
      </ul>
    <% } else { %>
      <div class="vazio">
        <h2>Nenhuma disciplina cadastrada</h2>
        <p>As disciplinas da turma aparecem aqui assim que forem cadastradas.</p>
      </div>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>